# ThetaWave AI - Environment Configuration Example
# OpenRouter API Key (Supports DeepSeek-V3, DeepSeek-R1, Llama 3.3 70B)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default AI Model (Options: deepseek/deepseek-chat, meta-llama/llama-3.3-70b-instruct:free, deepseek/deepseek-r1:free)
AI_MODEL=deepseek/deepseek-chat

# Optional: Google Gemini API Key fallback
# GEMINI_API_KEY=your_gemini_api_key_here
